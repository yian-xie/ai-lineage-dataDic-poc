      "id": "program:kb-ultracs-datawarehouse/KWDW_FEE:basic:program:KWDW_FEE",
      "type": "PROGRAM",
      "properties": {
        "source_path": "kb-ultracs-datawarehouse/KWDW_FEE",
        "confidence": "explicit",
        "name": "KWDW_FEE",
        "operations": [
          "OPEN CLIENT TO CLIENT",
          "OPEN KBDOSOUTPUT TO KBDOSOUTPUT",
          "WRITE LINE ON KBDOSOUTPUT,'DWFEE605.TXT'",
          "OPENSEQ 'KBDOSOUTPUT','DWFEE605.TXT' TO DWOUT ELSE STOP",
          "WRITESEQ LINE ON DWOUT ELSE STOP",
          "SELECT CLIENT",
          "T605: READNEXT ID ELSE",
          "READ LOGREC FROM KBDOSOUTPUT,'DWLOG.TXT' ELSE LOGREC=''",
          "WRITE LOGREC ON KBDOSOUTPUT,'DWLOG.TXT'",
          "READ CREC FROM CLIENT,ID ELSE STOP",
          "WRITESEQ ID:LINE ON DWOUT ELSE STOP"
        ],
        "assignments": [
          "SEP=\"|\"",
          "LINE=\"AccessNo|ExemptAll|ExemptFlat|Exempt85|ExemptATM|ExemptPOS\"",
          "LINE=LINE:\"|IVRCallFees|SMSBankingFees\"",
          "LINE=LINE:SEP:\"Operator\":SEP:\"Branch\":SEP:\"TIME\":SEP:\"DATE\"",
          "SEP=\"|\"",
          "CNT=0",
          "LINE=SEP:CREC<83>:SEP:CREC<84>:SEP:CREC<85>:SEP:CREC<86>:SEP:CREC<87>",
          "LINE=LINE:SEP:CREC<112>:SEP:CREC<113>",
          "LINE=LINE:SEP:CREC<88>:SEP:CREC<89>:SEP:OCONV(CREC<90>,\"MTS\"):SEP:OCONV(CREC<91>,'D4')",
          "CNT=CNT+1"
        ],
